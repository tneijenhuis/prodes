# copy .env.example to .env and modify as needed
# Set to true to calculate the full legacy feature set (105 features including
# redundant ones). Defaults to false for the reduced, non-redundant feature set.
PRODES_FULL_FEATURES=false

# Memory budget in MB for the intermediate NumPy arrays of one prodes run,
# divided among the workers. Eight workers with the default get 256 MB each, so
# the run as a whole stays under 2 GB whatever the worker count.
#
# This is a ceiling, not an allocation. A structure needs roughly
#     charged atoms x surface points x 48 bytes
# and uses only that much when it is under the budget: 22 MB for 1GDW (130
# residues), 682 MB for 1GPB (823 residues). Raising the budget above what a
# structure needs changes nothing, and lowering it below costs surprisingly
# little time. Measured on 1GPB: 127 s at 2048 MB and 117 s at 64 MB, with peak
# process RAM falling from 923 MB to 327 MB.
#
# Suggested values, at the default of 8 workers per run:
#   2048 for a 16 GB desktop running one protein at a time (~3 GB peak)
#   4096 for a 128 GB server running 10 proteins at a time (~50 GB peak)
#    512 under memory pressure, or lower PRODES_N_WORKERS instead
# The parsed structure, the grids and the surface points sit on top of this
# budget: about 170 MB on 1GPB, per prodes process, shared with the workers
# copy-on-write.
#
# Can also be set via the --mem-limit CLI flag, which takes precedence.
PRODES_MEM_LIMIT_MB=2048

# Number of worker processes used to parallelise the SASA, surface grid and
# shell calculations. Linux only: Windows and macOS always run serially, since
# the workers rely on the fork start method to share the structure and grid.
# Defaults to os.cpu_count() // 2, which approximates the physical core count on
# hyperthreaded systems (os.cpu_count reports logical cores). Set to 1 to force
# serial execution even on Linux. Each worker inherits the parent's memory
# copy-on-write and gets a share of PRODES_MEM_LIMIT_MB, so lowering this both
# frees memory and leaves each remaining worker a larger share. Anything other
# than a positive integer raises a ValueError at startup.
# Can also be set via the --n-workers CLI flag, which takes precedence.
# PRODES_N_WORKERS=8

# Chunk size for dispatching tasks to the workers (advanced tuning). The default
# of 1 gives the best load balancing, which matters because grid cells and atoms
# vary widely in cost. Raise it only if benchmarking shows dispatch overhead
# dominates. Can also be set via the --chunksize CLI flag.
# PRODES_CHUNKSIZE=1

# Workers force single-threaded BLAS on themselves (OPENBLAS_NUM_THREADS=1 and
# friends, applied via threadpoolctl), and the parent is held to one thread for
# as long as the workers exist, so that parallelism happens across processes
# rather than within them. Setting these here is only needed if you also want to
# limit BLAS in the parent outside the parallel phases.
# OPENBLAS_NUM_THREADS=1
# MKL_NUM_THREADS=1
# OMP_NUM_THREADS=1
