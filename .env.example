# copy .env.example to .env and modify as needed
# Set to true to calculate the full legacy feature set (105 features including
# redundant ones). Defaults to false for the reduced, non-redundant feature set.
PRODES_FULL_FEATURES=false

# Maximum memory in MB for intermediate NumPy arrays per chunk in vectorized
# calculations (e.g. find_exit_batch). Lower this value on machines with less RAM.
# Examples:
# PRODES_MEM_LIMIT_MB=8192 for server with 125 GB RAM, running 10 instances of prodes
# for prodes of protein complexes up to 1000 amino acids
# PRODES_MEM_LIMIT_MB=2048 for PC with 16 GB RAM, running 1 instance of prodes
# for prodes of protein complexes up to 1000 amino acids
# Can also be set via the --mem-limit CLI flag, which takes precedence.
PRODES_MEM_LIMIT_MB=2048
